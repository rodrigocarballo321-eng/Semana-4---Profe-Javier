<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SIGNAL_DESK.ViewModels;assembly=SIGNAL_DESK"
             x:Class="SIGNAL_DESK.MainPage"
             BackgroundColor="#0F172A">

    <ContentPage.BindingContext>
        <vm:MainViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto, Auto, *" Padding="16" RowSpacing="12">

        <!-- HEADER & SLA COUNTERS BAR -->
        <Border Grid.Row="0" BackgroundColor="#1E293B" Stroke="#334155" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="14,10">
            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                    <Label Text="SIGNAL DESK" FontSize="18" FontAttributes="Bold" TextColor="#F8FAFC" CharacterSpacing="0.5"/>
                    <Label Text="Help Desk Ticket Simulator &amp; SLA Monitor" FontSize="11" TextColor="#94A3B8"/>
                </VerticalStackLayout>

                <!-- Priority Counters -->
                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                    <Border BackgroundColor="#451A03" Stroke="#B45309" StrokeThickness="1" StrokeShape="RoundRectangle 4" Padding="8,4">
                        <Label Text="{Binding CountP1, StringFormat='P1 Critical: {0}'}" TextColor="#FDE68A" FontAttributes="Bold" FontSize="11"/>
                    </Border>
                    <Border BackgroundColor="#431407" Stroke="#C2410C" StrokeThickness="1" StrokeShape="RoundRectangle 4" Padding="8,4">
                        <Label Text="{Binding CountP2, StringFormat='P2 High: {0}'}" TextColor="#FFEDD5" FontAttributes="Bold" FontSize="11"/>
                    </Border>
                    <Border BackgroundColor="#365314" Stroke="#4D7C0F" StrokeThickness="1" StrokeShape="RoundRectangle 4" Padding="8,4">
                        <Label Text="{Binding CountP3, StringFormat='P3 Normal: {0}'}" TextColor="#ECFDF5" FontAttributes="Bold" FontSize="11"/>
                    </Border>
                    <Border BackgroundColor="#1E293B" Stroke="#475569" StrokeThickness="1" StrokeShape="RoundRectangle 4" Padding="8,4">
                        <Label Text="{Binding CountP4, StringFormat='P4 Low: {0}'}" TextColor="#94A3B8" FontAttributes="Bold" FontSize="11"/>
                    </Border>
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <!-- NEW TICKET FORM PANEL -->
        <Border Grid.Row="1" BackgroundColor="#1E293B" Stroke="#334155" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12">
            <Grid ColumnDefinitions="1.5*, 3*, Auto, Auto" RowDefinitions="Auto, Auto" RowSpacing="6" ColumnSpacing="8">
                <Label Grid.Row="0" Grid.ColumnSpan="4" Text="Register Support Ticket" TextColor="#E2E8F0" FontAttributes="Bold" FontSize="13"/>

                <Entry Grid.Row="1" Grid.Column="0" Placeholder="Client Name" Text="{Binding NewClient}" TextColor="#F8FAFC" PlaceholderColor="#64748B" BackgroundColor="#0F172A"/>
                <Entry Grid.Row="1" Grid.Column="1" Placeholder="Issue Summary" Text="{Binding NewSummary}" TextColor="#F8FAFC" PlaceholderColor="#64748B" BackgroundColor="#0F172A"/>

                <Picker Grid.Row="1" Grid.Column="2" ItemsSource="{Binding PriorityOptions}" SelectedItem="{Binding SelectedPriorityString}" TextColor="#F8FAFC" TitleColor="#64748B" BackgroundColor="#0F172A" WidthRequest="80"/>

                <Button Grid.Row="1" Grid.Column="3" Text="Create Ticket" Command="{Binding CreateTicketCommand}" 
                        BackgroundColor="#2563EB" TextColor="#FFFFFF" FontAttributes="Bold" HeightRequest="40" CornerRadius="6"/>
            </Grid>
        </Border>

        <!-- MAIN LAYOUT -->
        <Grid Grid.Row="2" ColumnDefinitions="3*, 2*" ColumnSpacing="12">

            <!-- TICKET LIST -->
            <Border Grid.Column="0" BackgroundColor="#1E293B" Stroke="#334155" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12">
                <Grid RowDefinitions="Auto, *">
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,8">
                        <Label Text="Active Queue" TextColor="#E2E8F0" FontAttributes="Bold" FontSize="14"/>
                        <HorizontalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Status:" TextColor="#94A3B8" VerticalOptions="Center" FontSize="12"/>
                            <Picker ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding SelectedStatusFilter}" TextColor="#F8FAFC" TitleColor="#64748B" BackgroundColor="#0F172A" WidthRequest="110"/>
                        </HorizontalStackLayout>
                    </Grid>

                    <CollectionView Grid.Row="1" ItemsSource="{Binding FilteredTickets}" SelectedItem="{Binding SelectedTicket}" SelectionMode="Single">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="#0F172A" Stroke="#334155" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="10" Margin="0,3">
                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                        <!-- Priority Indicator -->
                                        <Border Grid.Column="0" BackgroundColor="#1E293B" Stroke="#475569" StrokeThickness="1" StrokeShape="RoundRectangle 4" Padding="6,2" Margin="0,0,10,0" VerticalOptions="Center">
                                            <Label Text="{Binding Priority}" TextColor="#38BDF8" FontAttributes="Bold" FontSize="11"/>
                                        </Border>

                                        <!-- Details -->
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="{Binding Id}" TextColor="#F8FAFC" FontAttributes="Bold" FontSize="12"/>
                                                <Label Text="{Binding Client, StringFormat='· {0}'}" TextColor="#94A3B8" FontSize="12"/>
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding Summary}" TextColor="#CBD5E1" LineBreakMode="TailTruncation" FontSize="11"/>
                                            <Label Text="{Binding ResponseDueAt, StringFormat='SLA Due: {0:HH:mm yyyy-MM-dd}'}" FontSize="10" TextColor="#64748B"/>
                                        </VerticalStackLayout>

                                        <!-- Status & Warning -->
                                        <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" HorizontalOptions="End" Spacing="4">
                                            <Label Text="{Binding Status}" TextColor="#93C5FD" FontAttributes="Bold" FontSize="11" HorizontalOptions="End"/>
                                            <Border BackgroundColor="#450A0A" Stroke="#991B1B" StrokeThickness="1" StrokeShape="RoundRectangle 4" Padding="4,2" 
                                                    IsVisible="{Binding IsNearSlaBreach}">
                                                <Label Text="⚠️ BREACH RISK" FontSize="8" TextColor="#FCA5A5" FontAttributes="Bold"/>
                                            </Border>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>

            <!-- DETAIL PANEL -->
            <Border Grid.Column="1" BackgroundColor="#1E293B" Stroke="#334155" StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="12">
                <ScrollView>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Ticket Details" TextColor="#E2E8F0" FontAttributes="Bold" FontSize="14"/>

                        <Border BackgroundColor="#0F172A" Stroke="#334155" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="10">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding SelectedTicket.Id, StringFormat='ID: {0}'}" TextColor="#38BDF8" FontAttributes="Bold" FontSize="12"/>
                                <Label Text="{Binding SelectedTicket.Client, StringFormat='Client: {0}'}" TextColor="#E2E8F0" FontSize="12"/>
                                <Label Text="{Binding SelectedTicket.Status, StringFormat='Status: {0}'}" TextColor="#93C5FD" FontSize="12"/>
                                <Label Text="{Binding SelectedTicket.ResponseDueAt, StringFormat='SLA Deadline: {0:yyyy-MM-dd HH:mm}'}" TextColor="#94A3B8" FontSize="10"/>
                                <BoxView HeightRequest="1" Color="#334155" Margin="0,4"/>
                                <Label Text="Summary:" TextColor="#64748B" FontSize="10"/>
                                <Label Text="{Binding SelectedTicket.Summary}" TextColor="#F8FAFC" FontSize="12"/>
                            </VerticalStackLayout>
                        </Border>

                        <Button Text="Start Processing" Command="{Binding StartTicketCommand}" 
                                BackgroundColor="#0284C7" TextColor="#FFFFFF" FontAttributes="Bold" HeightRequest="38" FontSize="12" CornerRadius="6"/>

                        <Label Text="Resolution Notes" TextColor="#E2E8F0" FontAttributes="Bold" FontSize="12" Margin="0,4,0,0"/>
                        <Editor Text="{Binding ResolutionInput}" Placeholder="Add resolution details..." TextColor="#F8FAFC" PlaceholderColor="#64748B" BackgroundColor="#0F172A" HeightRequest="70"/>

                        <Button Text="Mark as Resolved" Command="{Binding ResolveTicketCommand}" 
                                BackgroundColor="#166534" TextColor="#FFFFFF" FontAttributes="Bold" HeightRequest="40" CornerRadius="6"/>

                        <Border BackgroundColor="#0F172A" Stroke="#334155" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="10" Margin="0,4,0,0">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Logged Resolution:" TextColor="#64748B" FontSize="10"/>
                                <Label Text="{Binding SelectedTicket.ResolutionNotes}" TextColor="#86EFAC" FontSize="11"/>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>
    </Grid>
</ContentPage>